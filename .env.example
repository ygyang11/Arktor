# ============================================================
# Arktor — Example Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# .env is git-ignored and will NOT be committed.
# For supported settings, configuration priority is:
# ARKTOR_* overrides > YAML configuration > service API keys below.
# Exported environment variables take precedence over values in this file.
# ============================================================

# --- LLM API Keys ---
# Default credentials for the selected provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Search API Keys ---
TAVILY_API_KEY=
SERPAPI_API_KEY=

# --- PDF Parsing API Keys ---
MINERU_API_KEY=
PADDLEOCR_API_KEY=

# --- Academic Paper API Keys ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Arktor LLM Overrides (optional, take precedence over YAML) ---
# ARKTOR_LLM_PROVIDER=openai
# ARKTOR_LLM_MODEL=gpt-4o
# ARKTOR_LLM_TEMPERATURE=0.7
# ARKTOR_LLM_MAX_TOKENS=4096
# ARKTOR_LLM_BASE_URL=
# ARKTOR_LLM_API_KEY=
# Include agent and call identifiers in API request headers.
# ARKTOR_LLM_SEND_REQUEST_CONTEXT=false

# --- Arktor General Overrides (optional, take precedence over YAML) ---
# ARKTOR_VERBOSE=false
# ARKTOR_TRACING_ENABLED=true

# --- CLI Options (optional) ---
# Select a configuration file instead of automatic discovery.
# ARKTOR_CONFIG=/path/to/arktor.yaml
# Disable update checks and notifications in the interactive CLI.
# ARKTOR_NO_UPDATE_CHECK=1
